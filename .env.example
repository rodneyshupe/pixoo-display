# Copy to .env and edit. Nothing here is secret; the optional MQTT password goes in .env.secret (git-ignored).
APPDATA_ROOT=/srv/appdata        # where the data folder lives: ${APPDATA_ROOT}/pixoo-display (settings, animations)
TZ=America/Vancouver             # your time zone (the clock, "today's" games)
PIXOO_HOST=192.168.1.50          # the Pixoo's IP address: give it a DHCP reservation
PORT=8017                        # the web app
PUBLIC_URL=                      # optional: its address, e.g. http://192.168.1.10:8017 (a link on the Home Assistant device)
# Optional Home Assistant entities over MQTT discovery. Leave MQTT_HOST empty to run without Home Assistant (the default).
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=pixoo
